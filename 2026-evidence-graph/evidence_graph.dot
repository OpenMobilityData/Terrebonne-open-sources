  d_platform [label="Ensemble Montréal election\nplatform, October 16, 2025 (65\npp.): cycling commitment «\nRéaliser un état des lieux du\nréseau cyclable afin d'évaluer les\nenjeux de sécurité des usagers »\n(p. 27); the CDN-NDG section (p.\n55) lists Canora, intersections\nnear schools and metros, Linton,\nBates; no mention of Terrebonne or\nof removing a lane\n[2025-10-16]", fillcolor="#fff3e8", shape=note, URL="https://openmobilitydata.github.io/Terrebonne-open-sources/2025-election-platform/raw/Ensemble-MTL-plateforme_2025-10.pdf#page=27", target="_blank"];
  d_eng_oct15 [label="Borough engineering division's\nreply of October 15, 2026 to the\nauthor's question on the westbound\nchannel: no maintenance,\nadjustment or works near the loop\nmid-February to mid-March 2026;\nthe only intervention a battery\nreplacement in early June; no\nevidence of a fault; a snowbank or\nobstacle on the westbound\n(parked-car) side offered as a\nhypothesis\n[2026-10-15]", fillcolor="#fff3e8", shape=note, URL="https://github.com/OpenMobilityData/Terrebonne-access-requests/blob/main/2026-581/derived/counter_revisions_and_westbound_channel_2026-10-21.md", target="_blank"];
  d_eco_oct21 [label="Eco-Counter's reply of October 21,\n2026, relayed by the division:\nfive revisions of the series since\nJuly 2025 (redistributions Nov\n21–26 and Mar 9–10;\nreconstructions Dec 25, May 29–31\nbicycles, June 8–9 motor); method\n(historical weekday ratio;\ncorrelated Verdun counters); no\nabnormal gap seen apart from\nNovember; four bicycle channels on\nthe site\n[2026-10-21]", fillcolor="#fff3e8", shape=note, URL="https://github.com/OpenMobilityData/Terrebonne-access-requests/blob/main/2026-581/derived/counter_revisions_and_westbound_channel_2026-10-21.md", target="_blank"];
  d_counter_note [label="Note of October 21, 2026\n(2026-581/derived): the supplier's\nrevisions, the four channels, the\ncheck of both releases (June\nexport has the November\nredistribution, not March's;\nOctober table lacks May 29–31 and\nJune 8–9), and the effect on each\nreleased figure\n[2026-10-21]", fillcolor="#fff3e8", shape=note, URL="https://github.com/OpenMobilityData/Terrebonne-access-requests/blob/main/2026-581/derived/counter_revisions_and_westbound_channel_2026-10-21.md", target="_blank"];
  d_ecocompteur [label="Eco-Compteur release of June 4,\n2026: the City moves its counter\nnetwork from inductive loops to\nCITIX-AI Evo camera counting\n(tender); counts stay on the\nopen-data platform and a new Power\nBI interface; quotes Neal Poku\n(Eco-Compteur) and Alexandre\nTeodoresco as « Responsable de\nl'optimisation, de la performance\nmunicipale et de l'innovation,\nComité exécutif »\n[2026-06-04]", fillcolor="#fff3e8", shape=note, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2026-city-bike-counters/README.md", target="_blank"];
