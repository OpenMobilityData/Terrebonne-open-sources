  c_petition2024 [label="2024 petitions by filter level\n(Oct 22, 2026): 1,203 stamped\nlines; 1,191 with any postal-code\nentry; 987 well-formed full codes;\n975 geocoded; 906 inside CDN-NDG\n(Loyola 553, NDG 331, Snowdon 17,\nDarlington 3, CDN 2); 599 in the\nTerrebonne corridor; the\norganizers' letter claims 1,138\n[2026-10-22]", fillcolor="#e6f6ef", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-access-requests/blob/main/2025-081/README.md", target="_blank"];
  c_deficits [label="Revenue less expenditures is\nnegative in 2008 (−13,966), 2012\n(−487,709), 2015 (−94,529), 2019\n(−735), 2022 (−31,771), 2023\n(−8,240) and 2024 (−18,655): seven\nof seventeen years; the 2024 gap\ngrew by 10,415 while compensation\nrose by 15,783\n[2026-10-23]", fillcolor="#e6f6ef", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2024-st-monica-cra-t3010/derived/t3010_summary.csv", target="_blank"];
  c_2024_change [label="2024 revenue 250,718 ÷ 266,650 − 1\n= −6.0 %; gifts (4500+4530)\n219,873 ÷ 234,216 − 1 = −6.1 %;\nyear-to-year moves 2019–2024 ran\nfrom −24 % to +28 % (revenue) and\n−15 % to +8 % (receipted gifts)\n[2026-10-23]", fillcolor="#e6f6ef", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2024-st-monica-cra-t3010/derived/t3010_summary.csv", target="_blank"];
  c_peer_diff [label="Sainte-Monique's 2023→2024 change\nin gifts −6.1 % against the twelve\npeers' median +0.8 % (middle half\n−11.2 to +19.9 %; seven up, five\ndown; rank 10 of 13); revenue −6.0\n% vs +5.0 % (rank 9); the parish\nwas above the peers' median in\n2022 and below from 2023\n[2026-10-23]", fillcolor="#e6f6ef", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2024-st-monica-cra-t3010/derived/peer_comparison_changes.csv", target="_blank"];
  c_threshold [label="Threshold = 2 SD of the pre-lane\nchanges: gifts 15–26 % (parish\nalone), 14–16 points (vs peers);\nwith seven months of lane in 2024,\na full-year effect must be ×12/7:\n25–45 % of gifts (21–50 % of\nrevenue) to stand apart; observed\n−6.1 % and −6.9 points; one full\nyear lowers it to 14–26 %, two to\n10–18 %\n[2026-10-23]", fillcolor="#e6f6ef", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2024-st-monica-cra-t3010/derived/detection_threshold.csv", target="_blank"];
  c_peer_streets [label="Of the twelve peers, none has a\nlane on a frontage that changed\nbetween the 2024 survey and today\nor between the two surveys except\nNotre-Dame-des-Neiges (av.\nLacombe, painted → protected after\nthe 2024 survey; it has a lot);\nSaint-Léon's protected lane is in\nboth surveys. Five have no\noff-street lot (Saint-Antonin,\nSaint-Malachie, Ascension of Our\nLord, Saint-Raymond,\nSainte-Catherine-de-Sienne); their\n2023→2024 gifts −13.6, −0.5,\n+72.6, +1.0, +21.9 % (median +1.0\n%), revenue median +0.5 %, against\n−6.1 % and −6.0 % at\nSainte-Monique\n[2026-10-23]", fillcolor="#e6f6ef", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2024-st-monica-cra-t3010/derived/peer_streets.csv", target="_blank"];
  c_frontage_signs [label="City sign inventory: on\nSainte-Monique's frontage\n(Terrebonne and Benny, within 80\nm), nine poles carry a « no\nstopping at any time » panel whose\nlast recorded action is an\ninstallation in July 2024 (Jul 2\nand 16), one more in Oct 2024;\nevery current panel on the\nchurch's side of Terrebonne reads\n« /A EN TOUT TEMPS »; on the other\nside street-cleaning panels\nremain. On the nine peer frontages\nin the inventory, at most two such\ninstallations in any month of\n2019–2024\n[2026-10-23]", fillcolor="#e6f6ef", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2024-st-monica-cra-t3010/derived/peer_streets_signs.csv", target="_blank"];
  c_sunday_curb [label="Share of the curb (street faces\nwithin 150 m of the church, by\nlength) closed to a visitor\nwithout a residents' permit on a\nSunday 10:00–12:00, from the\nCity's sign inventory:\nSaint-Antonin 48 %, Saint-Kevin 40\n%, Notre-Dame-de-Grâce 39 %,\nSainte-Monique 37 %,\nNotre-Dame-des-Neiges 29 %,\nSaint-Malachie 23 %, Saint-Ignace\n11 %, Sainte-Catherine 8 %,\nSaint-Raymond 5 %; reference\noutside the comparison, Saint\nMichael's and Saint Anthony's\n(Mile End, protected lane Oct\n2025, no lot) 88 %, 76 %\nresidents' permit. Faces with no\nsign counted open (closure\nunderstated); no count of spaces\n[2026-10-23]", fillcolor="#e6f6ef", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2024-st-monica-cra-t3010/derived/peer_streets.csv", target="_blank"];
  c_cold_days [label="Kensington counter (hourly\nworkbook, release of June 4,\n2026), December 1, 2025 – March\n31, 2026, with ECCC daily mean\ntemperature at Trudeau: 41 days\nwith a mean ≤ −10 °C, 1,075\nbicycle passages (median 26 a day,\n2 to 74); 68 days with a minimum ≤\n−10 °C, 2,143 (median 32);\nFebruary 2026: 978 passages, of\nwhich 300 on its 11 days at a mean\n≤ −10 °C; the coldest day (January\n24, mean −22.8 °C): 9; no day of\nthe four months had zero passages.\nLower bound (westbound channel\ndegraded from about March 1);\npassages, not people\n[2026-10-23]", fillcolor="#e6f6ef", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-access-requests/tree/main/2026-300/derived", target="_blank"];
  c_garages_1954 [label="Of the 126 residential buildings\nwith a Terrebonne address on the\nsixteen sheets available, 75 were\nbuilt with a garage = 59.5 %\n(north 57/90, south 18/36; by\ndwellings 192/324 = 59 %);\ngarages, not driveways; as built,\nnot as used; one sheet missing\n[2026-10-25]", fillcolor="#e6f6ef", shape=box, URL="https://openmobilitydata.github.io/Terrebonne-open-sources/1954-underwriters-plans-terrebonne-garages/", target="_blank"];
  c_garages_today [label="Present-day reading of 123 of the\n126 buildings on the Gouvernement\ndu Québec's aerial imagery (Oct\n25, 2026): a driveway, paved apron\nor parking pad visible on 79 (64\n%); built with a garage (1954–55)\nor with a driveway today: 89 (72\n%; north 70/89, south 19/34; by\ndwellings 221/303). Of the 1954–55\ngarages 64 keep a visible apron,\n10 do not; 15 buildings without a\ngarage in 1954–55 have a driveway\ntoday. Use inside a garage not\nvisible from above.\n[2026-10-25]", fillcolor="#e6f6ef", shape=box, URL="https://openmobilitydata.github.io/Terrebonne-open-sources/1954-underwriters-plans-terrebonne-garages/", target="_blank"];
}
subgraph cluster_assertion { label="assertions"; fontsize=11; color="#d9dcd8"; style="rounded";
  x_yearround [label="Assertion: the protected direction\nremoved for the winter will not be\nreinstalled in the spring, so the\none-direction layout becomes\nyear-round\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_99 [label="Assertion: bicycle traffic on\nTerrebonne falls by 99 % in winter\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_36rate [label="Assertion: the 3.6 % figure\nexpresses how much the lane is\nused in winter relative to the\nrest of the year\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_parking_measured [label="Assertion: the borough measured\nthe shortage of winter parking\nthat the conversion is meant to\nrelieve\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_decided [label="Assertion: the elected officials\nhave decided the winter conversion\n(the recommendation of the EXP\nnote has been acted on)\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_safety_addressed [label="Assertion: the safety compromises\nidentified by the SUM on June 17\nhave been answered in the layout\nto be voted on\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_portal [label="Assertion: the Kensington\ncounter's data are, or were,\npublished on the City's open-data\nportal\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_reopen [label="Assertion: the converted direction\nis restored as a protected lane\neach spring\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_manyyears [label="Assertion: the borough holds\nseveral years of counting data for\nwinter on Terrebonne\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_stormonly [label="Assertion: the option of closing\nthe lane only during snow-removal\noperations was assessed and found\nunworkable\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_shared [label="Assertion: the SUM analysis, the\nSIM opinion and the EXP note will\nbe made public before the December\n7 vote\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_consulted [label="Assertion: the Association des\npiétons et cyclistes de NDG was\nconsulted on the measure before it\nwas announced\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_sameside [label="Assertion: the direction converted\nto parking is the one in which\ncyclists ride with motor traffic\n(eastbound east of Cavendish,\nwestbound west of it)\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_entire [label="Assertion: the conversion applies\nto the full length of the lane,\nSt-Ignatius to Girouard\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_pass [label="Assertion: in the winter layout, a\ndriver can pass a cyclist in the\nsingle traffic lane while leaving\nthe metre the Code requires\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_double [label="Assertion: the borough would\nreconsider the measure if winter\nbicycle traffic doubled\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_bidir [label="Assertion: the lanes will be\nreplaced by a single bidirectional\nlane on one side of Terrebonne\nwith parking restored on the other\n(the layout of the August 13\nmandate and of Volet 2)\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_precedent [label="Assertion: before the vote on the\n2024 lanes, the borough published\nits study and held a public\ninformation session (the standard\nthe current measure is compared\nwith)\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_dec7 [label="Assertion: the borough council\nwill vote on the winter conversion\nat its sitting of December 7, 2026\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_since_jan [label="Assertion: the current\nadministration has been examining\nthe Terrebonne change since the\nbeginning of 2026 (the\ncouncillor's reported reply at the\nCafé Citoyens of October 18,\nunrecorded; also « since we got\ninto office », October 6)\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_campaign [label="Assertion: removing one direction\nof the Terrebonne lane in winter\nwas announced to voters as a\ncommitment during the 2025\ncampaign\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_info_coming [label="Assertion: the borough will\ncommunicate detailed information\non the winter change to residents\nbefore the council votes (the\nborough's stated intention, in\ncorrespondence seen by the author,\nis « au cours des prochaines\nsemaines », with no date and no\nsession named)\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_window4 [label="Assertion: the conversion of one\ndirection lasts about four months\neach winter (December to March),\nas opposed to the three months\nimplied by « d'avril à décembre »\n[2026-10-21]", fillcolor="#fff8e1", shape=octagon];
  x_hardship [label="Assertion: the protected lane\nbuilt on Terrebonne in 2024 has\ncaused a measurable loss of\nrevenue, or a deficit, at the\nparish of St Monica (fewer\nweddings and funerals, lost\nparking, « a first deficit in its\nhistory »)\n[2026-10-23]", fillcolor="#fff8e1", shape=octagon];
  x_done_deal [label="Assertion: the planned winter\nreconfiguration of rue de\nTerrebonne is certain to happen,\nwhatever the remaining steps\n(borough council vote, City\ncouncil vote, consultation, the\nwithheld studies). Distinct from\nx_decided (whether the elected\nofficials have decided): this one\nconcerns the outcome\n[2026-10-23]", fillcolor="#fff8e1", shape=octagon];
}
subgraph cluster_statement { label="statements"; fontsize=11; color="#d9dcd8"; style="rounded";
  s_oct6_99 [label="Oct 6 address, 39:33–40:49: «\nwe're able to see that in winter,\nthe volume of traffic diminishes\nby 99%. We go from 700 during the\ngood months to 8. That's 8\npassages, right? So that's 4\ncyclists, right? Including me,\nright? »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=2373s", target="_blank"];
  s_oct6_propose [label="Oct 6 address, 40:49: « So this is\nwhat we're going to propose. It's\ngoing to be a test. We're going to\nsee the data this year, and\nhopefully try to make it even\nbetter after »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=2449s", target="_blank"];
  s_oct6_decision [label="Oct 6, answering Raúl Garate,\n1:22:33: « juste avant que je vous\nparle, j'ai pu les mettre au\ncourant de cette orientation-là,\nparce qu'on a reçu le dernier\nrapport qui nous permettait de\nprendre une décision en consensus\nla semaine passée »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=4953s", target="_blank"];
  s_oct6_bidir [label="Oct 6 address, 39:33: « So\nbasically, we try to keep\nbidirectional one side putting it\non one side of the road, right? It\nwas too complicated and no real\nupside for anyone »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=2373s", target="_blank"];
  s_zoom [label="APC Zoom (cited at council as his\nconsultation): engineers would not\nsign a bidirectional lane;\nstorm-only ruled out (residents\ncould not be informed); \"50 to\n60\" spaces\n[2026-10]", fillcolor="#fdf1f1", shape=box];
  s_db_40 [label="Daybreak 07:03: the 8 = six rush\nhours; \"from 40 a day to 30 a day\nduring December to March\"\n[2026-10-09]", fillcolor="#fdf1f1", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2026-cbc-daybreak-interview/derived/2026-10-09_CBC_Daybreak_Teodoresco_transcript_en.md", target="_blank"];
  s_db_source [label="Daybreak 07:03: \"source of truth\n… open data website … connected\ndirectly to Eco-Counter\"\n[2026-10-09]", fillcolor="#fdf1f1", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2026-cbc-daybreak-interview/derived/2026-10-09_CBC_Daybreak_Teodoresco_transcript_en.md", target="_blank"];
  s_db_perm [label="Daybreak 12:22: \"for now, we're\nlooking at it in a way that will\nmake it permanent\" (ambiguous)\n[2026-10-09]", fillcolor="#fdf1f1", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2026-cbc-daybreak-interview/derived/2026-10-09_CBC_Daybreak_Teodoresco_transcript_en.md", target="_blank"];
  s_db_spaces [label="Daybreak 01:08: \"at least 50 to\n60\" spaces, \"a bit too early\"\n[2026-10-09]", fillcolor="#fdf1f1", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2026-cbc-daybreak-interview/derived/2026-10-09_CBC_Daybreak_Teodoresco_transcript_en.md", target="_blank"];
  s_db_final [label="Daybreak 00:38: \"the final study\n… still need to be submitted to\nus\"\n[2026-10-09]", fillcolor="#fdf1f1", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2026-cbc-daybreak-interview/derived/2026-10-09_CBC_Daybreak_Teodoresco_transcript_en.md", target="_blank"];
  s_db_window [label="Daybreak 03:11: \"December to\nMarch\"\n[2026-10-09]", fillcolor="#fdf1f1", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2026-cbc-daybreak-interview/derived/2026-10-09_CBC_Daybreak_Teodoresco_transcript_en.md", target="_blank"];
  s_cm_3 [label="City council 41:44: « on passe à 3\n% d'usage … décembre, janvier,\nfévrier et mars »\n[2026-10-19]", fillcolor="#fdf1f1", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2026-10-19-city-council/derived/2026-10-19_01.md", target="_blank"];
  s_cm_share [label="City council 41:44: « On n'a aucun\nproblème à partager nos documents\n»\n[2026-10-19]", fillcolor="#fdf1f1", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2026-10-19-city-council/derived/2026-10-19_01.md", target="_blank"];
  s_cm_counter [label="City council 44:51: « le seul\ncompteur disponible … retiré du\ndomaine public »; \"30 … 40\npassages par jour\"\n[2026-10-19]", fillcolor="#fdf1f1", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2026-10-19-city-council/derived/2026-10-19_01.md", target="_blank"];
  s_cm_36 [label="City council 7:38:24: \"3.6 % of\noverall cycling traffic\"\n[2026-10-19]", fillcolor="#fdf1f1", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2026-10-19-city-council/derived/2026-10-19_04.md", target="_blank"];
  s_cm_sign [label="City council 7:10:02: no lane «\nqui ne va pas être signée par les\ningénieurs »; « très content de\ncette décision »\n[2026-10-19]", fillcolor="#fdf1f1", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2026-10-19-city-council/derived/2026-10-19_02.md", target="_blank"];
  s_cm_fourmonths [label="City council 7:38:24: \"It's 3.6%\nthat we're talking about only for\nfour months, and then the rest we\nprotect and we keep as is\"\n[2026-10-19]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=rii3nUTuKRE&t=27504s", target="_blank"];
  s_oct6_official [label="Oct 6 address, 39:33: « when we\nlook at the data, right, and if we\nlooked at the official data\nprovided by the borough »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=2373s", target="_blank"];
  s_oct6_3years [label="Oct 6 address, 40:49: « during the\nwinter months, where we know, now\nhaving data for 3 years in a row,\nthat no, like 99% less traffic is\ngoing there in terms of biking\ntraffic »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=2449s", target="_blank"];
  s_oct6_30meetings [label="Oct 6 address, 38:16: « We've had,\nI think, more than 30 meetings on\nthis topic with the services, with\nprofessionals, from the central\ncity, from here, again and again »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=2296s", target="_blank"];
  s_oct6_promise [label="Oct 6 address, 38:16: « the bike\npath that has become such a\nsynonym of not being consulted,\nright? For a lot of people in the\nneighborhood, we have made a\ncommitment and we have to act on\nthis promise »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=2296s", target="_blank"];
  s_oct6_safety [label="Oct 6 address, 39:33: « to let the\nservices know that this can be\ndone, and we can keep the same\ncapacity, the same level of safety\nfor our kids, and bring back what\nis really, really important for a\nlot of our residents in Loyola and\nNotre-Dame-de-Grâce around the\nbike path, is more parking »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=2373s", target="_blank"];
  s_oct6_orientation [label="Oct 6 address, 39:33: « we're now\nready to give our orientation to\nthe services, and the services\nwill tell you how the mechanics of\nwhat the adjustment will happen\nduring this winter »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=2373s", target="_blank"];
  s_oct6_bikeplan [label="Oct 6 address, 40:49: « this will\nbe a part of a longer term, more\ninvolved - more sophisticated bike\nplan that we're also working right\nnow to deliver for next year »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=2449s", target="_blank"];
  s_oct6_consult [label="Oct 6, answering Raúl Garate,\n1:21:34: « J'étais en contact avec\nJason Savard tout à l'heure …\nDonc, M. Savard, c'est tous des\ngens que je respecte éminemment à\nl'Association des cyclistes et des\npiétons de l'NDG. J'étais en\ncontact avec eux avant, pendant,\net juste avant que je vous parle,\nj'ai pu les mettre au courant de\ncette orientation-là »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=4894s", target="_blank"];
  s_oct6_8for4 [label="Oct 6, answering Katherine Lund,\n1:46:26: « on va se mettre sur un\ncôté pendant ces mois-là, pour les\nhuit qui sont là, en fait pour les\nquatre, parce que c'est huit\ncomptages pour quatre cyclistes,\nje pense que c'est raisonnable »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=6386s", target="_blank"];
  s_oct6_perhour [label="Oct 6, answering Rick Hoge («\neight trips total in the month of\nJanuary? »), 2:22:06: « Per hour.\nHeure de pointe. Heure de pointe.\n» … (« these are eight trips per\nhour - not eight trips per day,\nright? ») « Yeah. heure de point.\nYeah. »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=8526s", target="_blank"];
  s_oct6_decision_slides [label="Oct 6, answering Rick Hoge,\n2:22:57: « we made a decision for\nwhat's going to happen to the to\nthe Terrebonne bike path based on\nthose slides and the numbers\nprovided by the expert who made\nspecific counting periods and\nrelying on the data that we have\nthere it's based on Miovision you\nknow, Miovision, right? »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=8577s", target="_blank"];
  s_oct6_readjust [label="Oct 6, answering Rick Hoge,\n2:25:41: « you can count on one\nthing I mean once we do test this\nnew configuration we will collect\ndata and we'll make sure that we\ncan readjust as well if there is\nthere is a need »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=8741s", target="_blank"];
  s_oct6_sameside [label="Oct 6, answering Rick Hoge,\n2:26:09–2:26:28: « we're keeping\none side of the bike path\nuntouched so you're if especially\nif you're coming with a cargo bike\n… you're able to use that\nprotected bike lane and if you\nwant you know you can come back on\nthe same road on the same with the\nsame side of traffic and so so\nthat I don't think a lot of\nparents who are motivated to drive\n- to bike in winter with their\nkids will be deterred by this\nproposal »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=8769s", target="_blank"];
