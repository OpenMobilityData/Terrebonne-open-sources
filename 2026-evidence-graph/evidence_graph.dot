  d_apc_letter [label="Letter of the Association des\npiétons et cyclistes de NDG to the\nborough mayor, sent October 22,\n2026 (copy to Alan DeSousa): asks,\nbefore the borough council votes,\n(1) a public information session\nfor residents of all affected\ndistricts with the services\npresent, (2) the release of the\nthree withheld documents (SUM\nanalysis of June 17, SIM opinion\nof July 13, EXP note), (3) the\ndates: « your office told Le\nDevoir the lane is kept from April\nto December; the councillor told\nCity council the removal lasts\nfour months. Which is it, and is\nit intended to recur every winter?\n»\n[2026-10-22]", fillcolor="#fff3e8", shape=note];
  d_t3010 [label="The public financial section of\nthe parish's 17 T3010 returns,\nfiscal 2008–2024: 2008–2018 from\nthe CRA's reply of Dec 6, 2024,\n2019–2024 as row extracts of the\nCRA's open-data files (fetched Oct\n23, 2026)\n[2026-10-23]", fillcolor="#fff3e8", shape=note, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2024-st-monica-cra-t3010/README.md", target="_blank"];
  d_t3010_2024 [label="The parish's T3010 return for\nfiscal 2024 (Jan 1–Dec 31, 2024;\nthe lane from June): revenue\n$250,718, expenditures $269,373,\nreceipted gifts $201,562, gifts\nwithout receipt $18,311, rental\n$15,339, other revenue $15,506 («\nFaith First, Virgil lights »),\ncash $197,111, liabilities\n$180,109\n[2026-10-04]", fillcolor="#fff3e8", shape=note, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2024-st-monica-cra-t3010/raw/open-canada/2024/financial_d_and_schedule_6_2024_updated.csv", target="_blank"];
  d_stmonica_note [label="The parish of St Monica's charity\nreturns (T3010), 2008 to 2024:\ndata, method and figures (EN and\nFR), with an abstract on the\nhypothesis of a measurable effect\nof the lane, a peer comparison, a\ndetection threshold and the\nparish's own statements\n[2026-10-23]", fillcolor="#fff3e8", shape=note, URL="https://openmobilitydata.github.io/Terrebonne-open-sources/2024-st-monica-cra-t3010/derived/st_monica_t3010_note_en.pdf", target="_blank"];
  d_parish_statements [label="The parish's financial statements\npublished in its bulletins:\nmonthly 2017–2019 and January\n2020, FY 2020 vs 2019 (approved\nOct 11, 2021), FY 2022,\nJanuary–March 2023; none since;\nthey agree with the returns to the\ndollar for 2019, 2020 and 2022\n[2023-04-23]", fillcolor="#fff3e8", shape=note, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2024-st-monica-cra-t3010/derived/parish_statements_monthly.csv", target="_blank"];
  d_bulletins [label="The parish's weekly bulletins on\nits website, 519 issues from May\n2014 to October 18, 2026, read in\nfull for the data note (not\nreproduced: they name individuals)\n[2026-10-18]", fillcolor="#fff3e8", shape=note, URL="https://www.stmonica.ca/bulletin", target="_blank"];
  d_fb_page [label="The parish's official Facebook\npage, searched on October 23, 2026\nfor bike, lane, path, parking,\npiste, Terrebonne, petition,\nrally, « save St. Monica »,\nMacKay: four posts concern the\nlane (three in 2020, one share in\n2024)\n[2026-10-23]", fillcolor="#fff3e8", shape=note, URL="https://www.facebook.com/stmonicamontreal", target="_blank"];
  d_rns [label="Religion News Service, Aug 13,\n2024, « Would Jesus park in a bike\nlane? For Philadelphia churches,\nit's a real question »: Tenth\nPresbyterian gives up its Sunday\npermit to park in a bike lane\nafter 18 weeks of cyclists'\nprotests; its pastor: neighbours «\nsee us as self-centered »; the\nEthical Society moved its parking\n(« the right thing to do »); Old\nPine Street Church supported the\nlanes; five of seven congregations\nfound alternatives\n[2024-08-13]", fillcolor="#fff3e8", shape=note, URL="https://religionnews.com/2024/08/13/would-jesus-park-in-a-bike-lane-for-philadelphia-churches-its-a-real-question/", target="_blank"];
  d_peer_returns [label="The T3010 financial sections of\nthe twelve other Catholic parishes\n(fabriques) of postal areas H3T,\nH3X, H3Z, H4A, H4B, H4V, H4W,\nfiscal 2015–2024, from the same\nopen-data files\n[2026-10-23]", fillcolor="#fff3e8", shape=note, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2024-st-monica-cra-t3010/derived/peer_parishes.csv", target="_blank"];
  d_city_bikenet [label="Ville de Montréal open data: «\nRéseau cyclable » (the network as\nof Oct 14, 2026, lane kind and\nfour-season protection per\nsegment) and « Auscultation du\nréseau cyclable » 2020 (fieldwork\nAug 2019–Nov 2020, 735 km\nsurveyed) and 2024 (May–Aug 2024,\n1,421 km), each recording the kind\nof every lane surveyed; CC BY 4.0\n[2026-10-23]", fillcolor="#fff3e8", shape=note, URL="https://donnees.montreal.ca/dataset/pistes-cyclables", target="_blank"];
  d_city_signs [label="Ville de Montréal open data «\nSignalisation – Stationnement »:\nevery parking-sign panel of the\nCity (not Westmount or\nCôte-Saint-Luc) with its pole,\nposition, text, status and the\ndate of its last recorded action;\ndownloaded Oct 23, 2026; CC BY 4.0\n[2026-10-23]", fillcolor="#fff3e8", shape=note, URL="https://donnees.montreal.ca/dataset/stationnement-sur-rue-signalisation-courant", target="_blank"];
  d_transcript_sept8 [label="Checked transcripts of the three\nTerrebonne items of the September\n8, 2026 borough council (checked\nby ear by the author; published\nOctober 23, 2026)\n[2026-10-23]", fillcolor="#fff3e8", shape=note, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2026-09-08-borough-council/README.md", target="_blank"];
  d_transcript_agglo_oct22 [label="Checked transcript of the\nTerrebonne question at the\nagglomeration council of October\n22, 2026 (the question as\nsubmitted in writing; the answer\nchecked by ear by the author;\npublished October 23, 2026)\n[2026-10-23]", fillcolor="#fff3e8", shape=note, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2026-10-22-agglomeration-council/README.md", target="_blank"];
  d_vz_page [label="City of Montréal, « Vision Zéro :\nse déplacer en sécurité à pied, en\nvélo et en auto », updated May 16,\n2025: « Vision Zéro est une\napproche qui vise à réduire à zéro\nle nombre de décès et de blessures\ngraves causés par une collision\nroutière. Montréal s'engage à tout\nmettre en œuvre pour atteindre cet\nobjectif d'ici 2040. »\n[2025-05-16]", fillcolor="#fff3e8", shape=note, URL="https://openmobilitydata.github.io/Terrebonne-open-sources/2016-vision-zero/raw/montreal-ca_vision-zero_page_2026-10-23.pdf#page=1", target="_blank"];
  d_vz_plan2025 [label="City of Montréal, Vision zéro\ndécès et blessé grave, Plan\nd'action 2025-2027 (third plan): «\n0 décès et blessés graves d'ici\n2040 », half by 2030 (pp. 12–13);\n« Sécuriser les parcours des\nusagers les plus vulnérables »\n(pp. 14–15); definitions (p. 65):\nprotected cycle lane = « séparées\nphysiquement de la circulation\nautomobile. Que ce soit par des\nbordures de béton ou des voitures\nstationnées »; unprotected = no\nphysical separation, « comme pour\nles bandes cyclables et les\nchaussées désignées »\n[2025-05-16]", fillcolor="#fff3e8", shape=note, URL="https://openmobilitydata.github.io/Terrebonne-open-sources/2016-vision-zero/raw/Plan_action_Vision_zero_2025-2027.pdf#page=33", target="_blank"];
  d_vz_plan2022 [label="City of Montréal, Plan d'action\nVision Zéro décès et blessé grave\n2022-2024 (second plan): «\nObjectif : zéro décès et blessé\ngrave d'ici 2040 » (pp. 6–7); «\nTous les plans locaux de\ndéplacement à venir, qu'ils soient\nnouveaux ou révisés, incluront\nl'approche Vision Zéro » (pp.\n34–35)\n[2022-11-10]", fillcolor="#fff3e8", shape=note, URL="https://openmobilitydata.github.io/Terrebonne-open-sources/2016-vision-zero/raw/plan_daction_vision_zero_2022-2024.pdf#page=18", target="_blank"];
  d_pld [label="CDN-NDG, Plan local de\ndéplacements 2024 à 2034 (adopted\nby the borough council, release of\nMay 10, 2024): objective 1 «\nAméliorer le confort et la\nsécurité pour les usagers et\nusagères vulnérables » (p. 30);\nobjective 3, school surroundings\nwhere « les modes actifs sont\nprioritaires et mieux protégés de\nla circulation des véhicules\nmotorisés » (p. 54); measure 3.1.1\n« Rehaussement des bandes\ncyclables existantes et chaussés\ndésignées en aménagements\ncyclables protégés »; « Les\naménagements cyclables rehaussés\net protégés devront permettre un\nentretien durant les quatre\nsaisons » (p. 55); measure 2.2.1 «\nLa pratique du vélo l'hiver est en\nconstante progression » (p. 42).\nDoes not name rue de Terrebonne\n[2024-05-10]", fillcolor="#fff3e8", shape=note, URL="https://openmobilitydata.github.io/Terrebonne-open-sources/2024-cdn-ndg-pld/raw/CDN-NDG_Plan_local_de_deplacements_2024-2034.pdf#page=55", target="_blank"];
  d_pld_release [label="Borough press release, May 10,\n2024, « Un Plan local de\ndéplacements visionnaire pour un\navenir durable à CDN-NDG »: « Les\nmembres du conseil\nd'arrondissement ont adopté le\ntout premier Plan local de\ndéplacements »\n[2024-05-10]", fillcolor="#fff3e8", shape=note, URL="https://openmobilitydata.github.io/Terrebonne-open-sources/2024-cdn-ndg-pld/raw/montreal-ca_communique_pld_2024-05-10_captured_2026-10-23.pdf#page=1", target="_blank"];
  d_cm_calendar [label="City of Montréal, « Conseil\nmunicipal » page and two event\npages, as captured October 23,\n2026: sittings Nov 16 and 17, Nov\n24 (extraordinary), Dec 14 and 15,\nDec 16 (extraordinary)\n[2026-10-23]", fillcolor="#fff3e8", shape=note, URL="https://openmobilitydata.github.io/Terrebonne-open-sources/2026-city-council-calendar/raw/montreal-ca_conseil-municipal_page_2026-10-23.pdf#page=1", target="_blank"];
  d_plans_1954 [label="Underwriters' Survey Bureau,\nInsurance plan of the city of\nMontreal, vol. 7, sheets 739, 775,\n784, 785, 787, 789, 798 (Nov.\n1954–Dec. 1955): every building\ndrawn, every garage marked « Auto\n»; sheet 787-8 missing\n[1955-12-31]", fillcolor="#fff3e8", shape=note, URL="https://collections.banq.qc.ca/ark:/52327/2244199", target="_blank"];
}
