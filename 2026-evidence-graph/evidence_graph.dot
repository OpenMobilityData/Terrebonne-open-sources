subgraph cluster_numerical_assertion { label="numerical assertions"; fontsize=11; color="#d9dcd8"; style="rounded";
  c_99 [label="\"99 %\" = 8 ÷ 707 (two different\nslides; like-for-like 97–98 %)\n[2026-10-06]", fillcolor="#e6f6ef", shape=box];
