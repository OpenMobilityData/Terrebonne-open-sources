  t_peer_changes [label="Each of the 13 parishes' change\n2023→2024 and 2024 vs its\n2022–2023 mean, gifts (4500+4530)\nand revenue, with ranks\n(peer_comparison_changes.csv);\ngifts indexed to 2017–2019\n[2026-10-23]", fillcolor="#e8f1fb", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2024-st-monica-cra-t3010/derived/peer_comparison_changes.csv", target="_blank"];
