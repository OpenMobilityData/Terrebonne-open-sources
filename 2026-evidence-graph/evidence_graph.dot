  s_cm_campaign [label="City council 7:10:02: « c'est ce\nqu'on s'est engagé à faire en\ncampagne et tout de suite après\nqu'on est arrivé à la mairie, de\nrevoir la configuration pour\nessayer, un, de garder le maximum\nde capacité de protection pour nos\nenfants et de ramener une mobilité\net un confort pour les résidents »\n[2026-10-19]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=rii3nUTuKRE&t=25802s", target="_blank"];
  s_eco_teo [label="« Mieux comprendre les\ndéplacements des cyclistes, grâce\nà une nouvelle génération de\ncompteurs non intrusifs et à une\nnouvelle plateforme de données\nouverte, nous permet de mieux\nrépondre aux besoins des\ncitoyennes et des citoyens. C'est\nun levier concret pour améliorer\nnotre performance et concevoir des\nmilieux de vie plus sécuritaires\net adaptés. » — Alexandre\nTeodoresco, quoted with his\nexecutive-committee title\n[2026-06-04]", fillcolor="#fdf1f1", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2026-city-bike-counters/README.md", target="_blank"];
  s_rc_teo [label="« Ça ne fait aucun sens de perdre\ndes données. » and « On n'a plus\nbesoin de passer par une tierce\npartie. » — Alexandre Teodoresco,\nexecutive committee member for\noptimization, municipal\nperformance and innovation, to\nRadio-Canada, May 29, 2026\n[2026-05-29]", fillcolor="#fdf1f1", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2026-city-bike-counters/README.md", target="_blank"];
  s_oct6_mayor_juste_milieu [label="« par rapport à la piste\nTerrebonne, par exemple, d'un\ncôté, il y a des gens qui veulent\nqu'on l'enlève carrément. Puis, ce\nn'est pas où nous voulons aller\ncomme administration. Nous\nessayons de trouver un juste\nmilieu qui fait en sorte qu'on\npeut réellement répondre à des\nbesoins, par exemple, au niveau de\nl'hiver et au niveau opérationnel\net aussi au niveau de la sécurité\nde nos résidents. » — the borough\nmayor, answering Louis-Eric\nTrudeau, Oct 6, 2026, webcast\n50:53\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=3053s", target="_blank"];
  s_oct6_oneside_winter [label="Oct 6 address, 40:49: « the\ncompromise … is basically to have\nit seasonal, to remove one side\nonly, during the winter months »;\n39:33: « The, the, the, the, the\nsolution that is the least\nproblematic is a seasonal one »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=2449s", target="_blank"];
  s_oct6_doors [label="Oct 6 address, 38:16: « when you\ndo door knocking on 1000s of\ndoors, and you see the most\nimportant issue for people there,\nright? It's accessibility around\nthe neighborhood and the bike path\nthat has become such a synonym of\nnot being consulted, right? »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=2296s", target="_blank"];
  s_oct6_counters [label="Oct 6 address, 39:33: « we have\ncounters everywhere, we have more\ncounters than before. So we know\nexactly how many people use it,\nwhen and how »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=2373s", target="_blank"];
  s_oct6_joutel_apc [label="Oct 6, Shannon Joutel, 1:13:36: «\nJe ne comprends pas comment ça se\nfait que vous n'aviez pas\ncommuniqué avec l'Association des\npiétons et cyclistes de NDG, ou\npuis comment ça se fait qu'il n'y\navait pas plus de transparence de\nrouvrir une consultation sur la\npiste déjà établie »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=4416s", target="_blank"];
  s_oct6_noconsult [label="Oct 6, answering Shannon Joutel,\n1:15:02: « je n'ai pas dit dans\nmon préambule en anglais qu'on\navait fait d'autres consultations\npubliques récemment, parce qu'on a\nquand même la chance, avec ce\ndossier depuis des années, d'avoir\naccumulé énormément de dossiers,\nde données, de rapports de\nconsultations »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=4502s", target="_blank"];
  s_oct6_consensus_wc [label="Oct 6, answering Shannon Joutel,\n1:15:02: « la raison pour laquelle\non est là aujourd'hui, c'est parce\nque les consultations qui avaient\nété faites, où beaucoup de voix se\nsont levées et se sont exprimées,\npour une configuration qui\nsemblait faire consensus, mais n'a\npas été respectée par\nl'administration précédente »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=4502s", target="_blank"];
  s_oct6_dayafterday [label="Oct 6, answering Shannon Joutel,\n1:15:02–1:16:17: « Les données sur\nlesquelles on s'est basé pour\narriver à cette orientation qu'on\ndonne, sont issues de nos experts\nà l'interne, vous voyez ici les\ndirecteurs, des données qui sont\ncollectées jour après jour, avec\ntoutes sortes de technologies de\ncomptage »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=4502s", target="_blank"];
  s_oct6_seasonal_fr [label="Oct 6, answering Shannon Joutel,\n1:16:17: « on est capable d'avoir\nun accommodement saisonnal,\njustement pour dire qu'en hiver,\nvu qu'il y a une si grosse\ndiminution de l'usage de la piste\ncyclable, on est capable de\nredonner des espaces de\nstationnement à toute la\ncommunauté qui est autour, qui en\na vraiment besoin, leurs besoins\nsont aussi légitimes que tous les\nautres de la population »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=4577s", target="_blank"];
  s_oct6_garate_bidir [label="Oct 6, Raúl Garate, 1:18:33: « Une\npiste cyclable bidirectionnelle\nest plus accidentogène à cause des\ncollisions frontales, mais aussi\npour les piétons qui vont devoir\nregarder à deux fois avant de\ntraverser. En faisant ça, je\ncrains qu'on sacrifie la sécurité\ndes plus vulnérables pour donner\nencore plus d'espace à l'auto »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=4713s", target="_blank"];
  s_oct6_700_300_100_8 [label="Oct 6, answering Raúl Garate,\n1:19:18: « Quand vous dites des\ncentaines de cyclistes, il y a une\ngrosse différence, et ce n'est pas\nseulement mon ressenti, c'est\nprouvé par les chiffres … on a vu\nqu'il y a une énorme différence\nentre le peak traffic dans les\nheures de pointe en été, les trois\nsaisons, et ce qui se passe en\ndécembre, janvier, février et\nmars. On est passé de 700, 300,\n100, 8 »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=4758s", target="_blank"];
  s_oct6_dixmois [label="Oct 6, answering Raúl Garate,\n1:20:26: « Je suis désolé, quand\nil fait moins 10, là, en février,\ntu ne vas pas prendre ton vélo\npour aller à l'école tout seul. Je\nsuis désolé, on va le faire\npendant les autres 10 mois de\nl'année. Et ça sera un compromis\nqu'on va devoir faire »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=4826s", target="_blank"];
  s_oct6_premier_conseil [label="Oct 6, answering Raúl Garate,\n1:21:34: « ce dossier-là, que vous\nsachiez, le premier conseil\nd'arrondissement, on a dit qu'on\ndevait faire quelque chose dont\nc'était commis en campagne\nélectorale, qu'on allait regarder\net ramener une certaine balance à\ncette piste cyclable-là »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=4894s", target="_blank"];
  s_oct6_malfaite [label="Oct 6, answering Raúl Garate,\n1:21:34: « cette piste cyclable-là\nqui a été mal faite, mal conçue,\nqui a été rentrée dans la gorge de\ntout le monde sans aucune écoute\ndes vrais besoins des gens autour\n»\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=4894s", target="_blank"];
  s_oct6_voie_mitoyenne [label="Oct 6, answering Raúl Garate,\n1:24:21: « les plus grands fans du\nvélo qui veulent éliminer l'auto à\ntout prix ne vont pas aimer cette\nsolution-là. Et le contraire\naussi. Les gens qui ne veulent\nplus voir de vélo ne vont pas\naimer non plus. Parce qu'on ne\npeut pas satisfaire. Il faut\ntrouver cette voie mitoyenne de\npassage qui, d'après moi, est la\nvoie pragmatique, la voie d'une\nbalance »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=5061s", target="_blank"];
  s_oct6_lund_petition [label="Oct 6, Katherine Lund, 1:42:37,\nhanding in a sheet of signatures\ngathered outside the sitting: «\n\"Je suis résidente de NDG et je\nsigne pour préserver la piste de\nTerrebonne au complet pour l'année\nlongue. I am an NDG resident and I\nam signing to preserve the entire\nTerrebonne bike path year long.\"\n»\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=6157s", target="_blank"];
  s_oct6_lund_quatre [label="Oct 6, Katherine Lund, 1:49:03: «\nJe voudrais juste faire un petit\npoint. Vous parlez de huit\npersonnes qui traversent, c'est\njuste, donc, quatre »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=6543s", target="_blank"];
  s_oct6_huit_journees [label="Oct 6, answering Katherine Lund,\n1:44:47: « on s'est battu pour\nvraiment la garder à 100% de\ncapacité pendant tous les mois où\nelle est effectivement utilisée\npar les familles et les jeunes.\nQuand on arrive dans des journées\noù il y a huit personnes qui\nl'utilisent, c'est difficile que\nje dise à tous nos résidents … »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=6287s", target="_blank"];
  s_oct6_100pct [label="Oct 6, answering Katherine Lund,\n1:44:47: « c'est pour ça qu'on va\nabsolument, on s'est battu pour\nvraiment la garder à 100% de\ncapacité pendant tous les mois où\nelle est effectivement utilisée\npar les familles et les jeunes »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=6287s", target="_blank"];
  s_oct6_snow_rationale [label="Oct 6, answering Katherine Lund,\n1:46:02: « je pense que c'est\nraisonnable que dans les mois\nd'hiver, parce qu'avec les\nencombrements de neige, les\nopérations de déneigement, qu'on\nne peut pas se garer à gauche, à\ndroite, d'un jour à l'autre, et\nque ça devient encore plus\ndifficile pour les gens d'un\ncertain âge de se déplacer,\nd'avoir accès à leur parking pas\ntrop loin de chez eux, je pense\nque c'est raisonnable qu'on fasse\ncet effort-là »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=6362s", target="_blank"];
  s_oct6_engagement [label="Oct 6, answering Katherine Lund,\n1:46:02: « Donc, moi je pense que\nc'est raisonnable notre position,\net on va le faire, on va le tester\ncette année, parce que c'était un\nde nos engagements de campagne\ndepuis l'année passée, et c'est\nnotre devoir de respecter notre\npromesse »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=6362s", target="_blank"];
  s_oct6_minor [label="Oct 6, answering Katherine Lund,\n1:48:07: « c'est pour ça que ce\nqu'on propose, nous, c'est un,\nsoit dit en passant, un ajustement\nrelativement mineur »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=6487s", target="_blank"];
  s_oct6_hoge_40 [label="Oct 6, Rick Hoge, 2:20:14: « In\nNovember 2025 the average daily\nbike count was 207 trips per day\nreaching up to 507 trips per day\non the maximum. From December 1st\nto March 31st the average daily\nbike count on Terrebonne was 40\ntrips per day, reaching a maximum\nof 123 trips per day » (figures\nfrom the hourly workbook released\nunder request 2026-300)\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=8414s", target="_blank"];
  s_oct6_12and8 [label="Oct 6, answering Rick Hoge,\n2:21:33: « I'm a data driven guy\nand so I've used the official data\nprovided to me by the services and\nI have it right in front of me I\ncan read the slide January 12\ntrips per hour peak hour right so\nmaybe that's your 40 a day and on\nthe other side eight trips in\nJanuary »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=8493s", target="_blank"];
  s_oct6_scenarios [label="Oct 6, answering Rick Hoge,\n2:24:19: « we've done like\ncountless and countless work\nmeetings and and review the data\nand work with the professionals we\nstudied you know a dozen potential\nscenarios … so we will not have no\nno we will not have another moment\nto consult now before the\nimplementation »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=8659s", target="_blank"];
  s_oct6_internal_doc [label="Oct 6, answering Rick Hoge,\n2:25:06–2:25:41: « look we have\nthe study I think it's a working\ndocument - an internal working\ndocument I'm not myself\nexperienced enough to say that we\ncan release that report maybe a\nversion of that to explain the\nrationale but I'm not sure that we\ncan do that »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=8706s", target="_blank"];
  s_oct6_mayor_inform [label="Oct 6, the borough mayor after\nRick Hoge's question, 2:26:40: «\nwith regards to communication and\ninforming the school the parents\nwe are definitely going to work\nextremely hard to make sure that\neveryone will be aware of the\nchanges that will be taking place\non Terrebonne »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=8800s", target="_blank"];
  s_oct6_twothirds [label="Oct 6, answering Steven Jazz,\n2:30:33: « when I see the numbers\nof vehicle traffic really drop by\ntwo-thirds, I think overall it's a\nbit safer for the kids »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=9033s", target="_blank"];
  s_oct6_timeline [label="Oct 6, answering Steven Jazz,\n2:31:44: « So, look, we'll do that\nthis winter if the schedule, the\ntimeline allows, but we'll measure\nthe impact and we'll be able to\nadjust accordingly after »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=9104s", target="_blank"];
  s_oct6_jazz_three [label="Oct 6, Steven Jazz, 2:32:23: « If\nI can just say, if there really is\nonly three cyclists in the winter,\nor whether it's three cyclists per\nhour in the winter, how does that\nstill justify leaving the thing\nopen? »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=9143s", target="_blank"];
  s_oct6_network [label="Oct 6, answering Steven Jazz,\n2:32:39: « Because we understand\nthat it takes an infrastructure\nthat is still in place during\nwinter to allow people to get\ncomfortable riding in winter, and\nit's a network effect thing. So,\nwe need to keep some capacity all\nacross the network »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=9159s", target="_blank"];
  s_fb_2020jul25 [label="Parish Facebook page, July 25,\n2020: « An appeal to our\nparishioners to take note that if\nthis bike path proceeds as\nplanned, there will be no parking\non either side of Terrebonne from\nBelmore to Oxford. Many of our\nparishioners are elderly or have\nreduced mobility. There will be no\nplace to park for people attending\nweddings or funerals, not to\nmention Sunday Mass … Please\nconsider signing (and sharing) the\npetition » (7 reactions, 4\ncomments, 2 shares)\n[2020-07-25]", fillcolor="#fdf1f1", shape=box, URL="https://www.facebook.com/stmonicamontreal", target="_blank"];
  s_fb_2020sep4 [label="Parish Facebook page, September 4,\n2020: « There will be a motion\nproposed at borough council on\nSeptember 8 for its removal …\nObviously, everyone is entitled to\ntheir own opinion in these\nmatters. And as I pointed out at\nthe Press Conference, the church\nis deeply concerned about the\nenvironment and wants our streets\nto be safe and healthy for\neveryone. So please feel free to\ntake whatever action you believe\nto be best in this matter »,\nfollowed by a citizens'\ncommittee's instructions\n[2020-09-04]", fillcolor="#fdf1f1", shape=box, URL="https://www.facebook.com/stmonicamontreal", target="_blank"];
  s_fb_2024aug14 [label="Parish Facebook page, August 14,\n2024, sharing the RNS article on\nPhiladelphia churches giving up\nbike-lane parking: « An article\nrelevant to many of our parish\ncommunities in Montreal! » (one\nreaction, one comment); the\nparish's only official public\ncomment on bike lanes since the\n2024 lane\n[2024-08-14]", fillcolor="#fdf1f1", shape=box, URL="https://www.facebook.com/stmonicamontreal", target="_blank"];
  s_bul_2023oct15 [label="Parish bulletin, October 15, 2023:\n« Through the kindness of the\nMacKay Center, our next door\nneighbour, we have secured\nadditional parking spaces for\nthose attending Mass at St.\nMonica's Church during the\nweekends on Saturdays and Sundays\nthroughout the year … a minimum\none time donation of $5.00 per\nparking pass »; repeated to\nDecember 3, 2023, not mentioned\nafter\n[2023-10-15]", fillcolor="#fdf1f1", shape=box, URL="https://www.stmonica.ca/bulletin", target="_blank"];
  s_bul_2024nov3 [label="Parish bulletin, November 3, 2024\n(repeated Nov 10 and 17): « THE\nSAVE ST. MONICA'S SUPPORT GROUP\nWITH THE ST. MONICA'S FUNDRAISING\nCOMMITTEE will be holding a rally\nin the church basement, Sunday\nNovember 24th immediately after\nthe 11am mass … Admission is free\nbut a donation at the door would\nbe greatly appreciated. Tax\nreceipts will be issued for any\ndonation over $25.00 »; no reason\ngiven, no outcome published\n[2024-11-03]", fillcolor="#fdf1f1", shape=box, URL="https://www.stmonica.ca/bulletin", target="_blank"];
  s_bul_2025dec21 [label="Parish bulletin, December 21,\n2025, « Fundraising financials\n(2024–2025) »: events 2024\n$35,605.29, events 2025\n$28,673.65, general fundraising\n$36,986.00, donor tree $62,593.00,\noverall $163,857.94 raised,\n$13,687.02 expenses, $149,515.92\nremaining; major repairs 2025\n$25,954.58 (rectory water leak\n$14,954.58), $123,561.34 remaining\n[2025-12-21]", fillcolor="#fdf1f1", shape=box, URL="https://www.stmonica.ca/bulletin", target="_blank"];
  s_sep8_dozen [label="Sept 8 opening remarks, 34:25: «\nSince day one, we've looked at a\ndozen or more of scenarios …\nmeasuring tape on different parts\nof the biking path in our borough\nand across the city … to see\nprecedents and comparables »\n[2026-09-08]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=zmp-p8V_w_A&t=2065s", target="_blank"];
  s_sep8_study [label="Sept 8 opening remarks, 34:25: «\nin the next couple of days, we\nwill have an update, because it's\nnow at the final stage of the\nstudy that we submitted recently\nwith the services, and the\nservices have promised us a final\nanswer in the next few days »\n[2026-09-08]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=zmp-p8V_w_A&t=2065s", target="_blank"];
  s_sep8_orientation [label="Sept 8 opening remarks, 35:29: «\nSo before the end of fall, you\nwill have our own orientation on\nwhat's going to happen this winter\nwith the Terrebonne bike path. So\nit's coming. »\n[2026-09-08]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=zmp-p8V_w_A&t=2129s", target="_blank"];
  s_sep8_jass_twoway [label="Sept 8, Steven Jass, 1:07:19: « I\nhope I don't know is it part of\nAlex's 10, 12 scenarios to return\nTerrebonne to two-way »\n[2026-09-08]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=zmp-p8V_w_A&t=4039s", target="_blank"];
  s_sep8_mayor_winter [label="Sept 8, the borough mayor,\nanswering Steven Jass, 1:07:54: «\nAlex in his introduction very\nclearly explained where we are at\ncurrently on the bike path and the\nmodifications that will take place\nin the coming weeks on the bike\npath. For now i can't pronounce\nmyself on what is this scenario,\nbut in due time everyone will\nunderstand what the changes will\ntake - will be for the winter\nperiod. »\n[2026-09-08]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=zmp-p8V_w_A&t=4074s", target="_blank"];
  s_sep8_mcqueen_apc [label="Sept 8, Peter McQueen, council\nmembers' question period,\n2:33:21–2:34:51: whether the\nconsultation reaches beyond\nLoyola, and « est-ce que vous avez\nparlé à l'Association des\ncyclistes et piétons de\nNotre-Dame-de-Grâce … Qui\nconsultez-vous sur les changements\nque vous prévoyez sur la piste\ncyclable Terrebonne? »\n[2026-09-08]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=zmp-p8V_w_A&t=9201s", target="_blank"];
  s_sep8_ideology [label="Sept 8, the councillor, answering\nPeter McQueen, 2:36:25: « on a\nacquiescé que la piste cyclable de\nTerrebonne avait été faite pour\ndes mauvaises raisons. La façon\ndont ça s'est fait au début,\nc'était vraiment une imposition\nbasée sur une idéologie. »\n[2026-09-08]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=zmp-p8V_w_A&t=9385s", target="_blank"];
  s_sep8_consult [label="Sept 8, the councillor, answering\nPeter McQueen, 2:37:41: « on a\nrefait une dernière phase de\nconsultation pour revalider les\nparamètres … on a refait\nénormément de va-et-vient avec les\nexperts, les premiers qui avaient\ndesigné ça, nos services … la\nnouvelle mouture qu'on va proposer\nbientôt, une fois qu'on reçoit\nl'étude qui va nous venir des\nservices d'ici, comme je disais,\nquelques semaines »\n[2026-09-08]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=zmp-p8V_w_A&t=9461s", target="_blank"];
  s_sep8_frustrate [label="Sept 8, the councillor, answering\nPeter McQueen, 2:38:50: « j'espère\nsincèrement qu'on va trouver une\nsituation mitoyenne qui, si elle\nest bien faite, va frustrer autant\nles amateurs à fond du vélo et\naussi les gens qui roulent que en\nvoiture … Parce que si on arrive à\nfrustrer les deux côtés en même\ntemps, on va savoir qu'on a trouvé\nune voie de passage au milieu. »\n[2026-09-08]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=zmp-p8V_w_A&t=9530s", target="_blank"];
  s_sep8_mcqueen_prepare [label="Sept 8, Peter McQueen, after the\ncouncillor's answer,\n2:39:26–2:39:50: « the\nadministration is planning changes\nto the Benny - the Terrebonne\nbicycle path. They're going to be\nannounced in the next days or\nweeks, certainly before the next\nBorough Council meeting, which is\nTuesday, October 6th … So cyclists\nof NDG prepare to come out then\nand demand a consultation and make\nsure that your voice is heard too\non these changes. »\n[2026-09-08]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=zmp-p8V_w_A&t=9566s", target="_blank"];
  s_oct6m_worstdays [label="Oct 6, council members' question\nperiod, Peter McQueen to the\ncouncillor, 2:48:05–2:49:15: « il\ny a une différence entre les dix\npires jours de l'hiver et les cent\nautres jours de l'hiver … Alors,\nvous êtes d'accord que ça ne sert\nà rien de mesurer le trafic le\njour, le pire jour de l'hiver où\nil y a un pied de nouveau neige\npar terre? Ce n'est pas ce jour-là\nqui compte, c'est les autres 100\njours. OK. Alors, on the record,\nyou said that? »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=10085s", target="_blank"];
  s_oct6m_exact [label="Oct 6, council members' question\nperiod: Peter McQueen: « Ce que\nvous étudiez, c'est d'enlever une\ncôté de la piste. Seulement un\ncôté et seulement l'hiver. Alors,\nseulement un côté l'hiver, alors\ndurant l'été, ça retournerait à\nl'autre côté. » The councillor: «\nExact. C'est exactement ça. »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=10173s", target="_blank"];
  s_oct6m_ops [label="Oct 6, the councillor, answering\nwhether the other side would be\nwidened or cleared better,\n2:50:09: « Enlever la neige, si on\nse commet à avoir des\ninfrastructures cyclables d'hiver,\nil faut qu'on soit à la hauteur\npour les entretenir … pendant les\ndix jours les pires de l'hiver …\non va laisser une chance aux\néquipes de travailler sur tout le\nreste du territoire … Donc il\nfallait qu'on prenne des décisions\naussi au niveau de ce qui était\nfaisable au niveau opération et\nbudgétaire. »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=10209s", target="_blank"];
  s_oct6m_lines [label="Oct 6, the councillor, 2:50:27: «\nEt amener des changements\nimportants à la configuration. Je\npense que c'est très difficile au\nniveau opération puis budget pour\nle marquage, défaire des lignes,\nrefaire des lignes. Je pense même\nqu'au niveau de tout ce qui est\ncompliant avec les regulations, ça\nne permettrait pas de faire ça. »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=10227s", target="_blank"];
  s_oct6m_window [label="Oct 6, the councillor, 2:50:46: «\nDonc, notre plan, comme vous avez\ndit, M. McQueen, c'est d'enlever\nune ligne, un côté seulement,\npendant les mois d'hiver. Décembre\nà avril. Décembre à fin mars.\nThat's it. »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=10246s", target="_blank"];
  s_ag_question [label="Oct 22, agglomeration council,\nDavid Gamper's written question,\nread by the chair: a single\ntraffic lane about 3.5 m wide\nbetween two rows of parked cars; «\nThe minimum separation of one\nmetre required to pass a cyclist\nis not available, and this forces\neither unsafe overtaking or cars\nto drive behind cyclists at their\nspeed »; snow and ice push\ncyclists further out; « has the\nSPVM been consulted on this\nlayout? And what is their opinion?\nWill they carry out increased\nsurveillance ? »\n[2026-10-22]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=a0Q0veyhra0&t=1798s", target="_blank"];
  s_ag_notheard [label="Oct 22, the councillor, 31:18: «\nWe have to start by acknowledging\nthat many residents felt that\ntheir concerns regarding the\nTerrebonne bike path were not\nheard by the previous\nadministration. We heard this\nmessage clearly … not a dogmatic\none, but a very pragmatic one. »\n[2026-10-22]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=a0Q0veyhra0&t=1878s", target="_blank"];
  s_ag_approach [label="Oct 22, the councillor, 31:38: «\nResidents expect us to listen and\nto act, and this is exactly what\nwe're doing. Our approach is\nsimple, listen, act, evaluate the\nresults, and adjust as needed. »\n[2026-10-22]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=a0Q0veyhra0&t=1898s", target="_blank"];
  s_ag_test [label="Oct 22, the councillor, 31:55: «\nThat is why we're introducing a\nnew winter configuration on the\nTerrebonne bike path and testing\nit over the coming months. We will\nalso consult residents to hear\ntheir feedback and better\nunderstand how this configuration\nresponds to the needs of the\nneighborhood. »\n[2026-10-22]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=a0Q0veyhra0&t=1915s", target="_blank"];
  s_ag_counters [label="Oct 22, the councillor,\n31:55–32:29: « And to make sure\nthat our evaluation is based not\nonly on feedback but also on\nobjective data, I have asked that\nour new generation of traffic\ncounters be deployed on Terrebonne\nStreet starting this winter. This\nwill help us better measure how\nthe street is being used and the\nimpact of the new configuration. »\n[2026-10-22]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=a0Q0veyhra0&t=1933s", target="_blank"];
  s_ag_safety [label="Oct 22, the councillor,\n32:13–32:48: « Public safety is\nparamount in our endeavor to find\nthe right balance. And I say this\nnot only as an elected official\nbut also as an avid cyclist and as\nthe father of two young cyclists\nwho use the bike path … we're not\nlooking to impose a\none-size-fits-all solution »\n[2026-10-22]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=a0Q0veyhra0&t=1949s", target="_blank"];
  s_oct6_droitvivre [label="Oct 6, the councillor, answering\nRaúl Garate, continuing from « on\nva le faire pendant les autres 10\nmois de l'année »: « Et ça sera un\ncompromis qu'on va devoir faire,\nparce que j'ai eu trop, trop, trop\nde personnes, de résidents, dans\ntout NDG, dans tout Loyola, qui\nm'ont fait part de leur grande,\ngrande détresse à ne pas pouvoir\nvivre leur façon de vivre, parce\nqu'ils n'ont aucun endroit où\nstationner leur voiture … C'est le\nconfort pour ces gens qui ont\naussi le droit de vivre selon leur\nfaçon. »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=0k_KZf9uxTk&t=4826s", target="_blank"];
  s_sep8_choices [label="Sept 8, the councillor, answering\nPeter McQueen, 2:36:25: « Moi,\nj'estime que les choix de mobilité\nqu'on fait chacun d'entre nous,\nqui peuvent différencier d'un jour\nà l'autre, ne devraient pas être\nun positionnement politique. Ça\ndoit être un choix libre et neutre\noù on peut optimiser nos\ndéplacements sans devoir faire des\njugements de valeur sur comment\nles autres, les résidents, les\nautres concitoyens décident de se\ndéplacer. »\n[2026-09-08]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=zmp-p8V_w_A&t=9385s", target="_blank"];
  s_cm_visionzero [label="City council, October 19, a\nresident's complementary question\nto the executive-committee member\n(answered by Councillor\nTeodoresco): the SUM's opinion\nfound that the options «\nprésentent plusieurs compromis\nimportants sur le plan de la\nsécurité, du confort des usagers\nvulnérables et de la cohérence du\nréseau cyclable »; « Donc, est-ce\nque vous réitérez votre appui à\nune décision qui va contre l'avis\ndes experts de la Ville et contre\nla politique Vision Zéro ? »\n[2026-10-19]", fillcolor="#fdf1f1", shape=box, URL="https://www.youtube.com/watch?v=rii3nUTuKRE&t=25731s", target="_blank"];
}
