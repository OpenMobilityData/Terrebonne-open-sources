  s_db_perm [label="Daybreak 12:22: \"for now, we're\nlooking at it in a way that will\nmake it permanent\" (ambiguous)\n[2026-10-09]", fillcolor="#fdf1f1", shape=box];
  s_db_spaces [label="Daybreak 01:08: \"at least 50 to\n60\" spaces, \"a bit too early\"\n[2026-10-09]", fillcolor="#fdf1f1", shape=box];
  s_db_final [label="Daybreak 00:38: \"the final study\n… still need to be submitted to\nus\"\n[2026-10-09]", fillcolor="#fdf1f1", shape=box];
  s_db_window [label="Daybreak 03:11: \"December to\nMarch\"\n[2026-10-09]", fillcolor="#fdf1f1", shape=box];
  s_cm_3 [label="City council 41:44: « on passe à 3\n% d'usage … décembre, janvier,\nfévrier et mars »\n[2026-10-19]", fillcolor="#fdf1f1", shape=box];
  s_cm_share [label="City council 41:44: « On n'a aucun\nproblème à partager nos documents\n»\n[2026-10-19]", fillcolor="#fdf1f1", shape=box];
  s_cm_counter [label="City council 44:51: « le seul\ncompteur disponible … retiré du\ndomaine public »; \"30 … 40\npassages par jour\"\n[2026-10-19]", fillcolor="#fdf1f1", shape=box];
  s_cm_36 [label="City council 7:38:24: \"3.6 % of\noverall cycling traffic\"\n[2026-10-19]", fillcolor="#fdf1f1", shape=box];
  s_cm_sign [label="City council 7:10:02: no lane «\nqui ne va pas être signée par les\ningénieurs »; « très content de\ncette décision »\n[2026-10-19]", fillcolor="#fdf1f1", shape=box];
  s_cm_fourmonths [label="City council 7:38:24: \"It's 3.6%\nthat we're talking about only for\nfour months, and then the rest we\nprotect and we keep as is\"\n[2026-10-19]", fillcolor="#fdf1f1", shape=box];
}
