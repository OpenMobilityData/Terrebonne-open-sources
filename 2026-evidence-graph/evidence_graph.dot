  s_db_doors [label="Daybreak 01:53: « I've knocked on\n4,000 doors during the campaign »;\n02:37: « we logged more than 40\nmeetings and work sessions »\n[2026-10-09]", fillcolor="#fdf1f1", shape=box];
  s_db_adjust [label="Daybreak 04:49: « We'll adjust\nthis bike path for now, and we'll\nsee … »\n[2026-10-09]", fillcolor="#fdf1f1", shape=box];
  s_db_age [label="Daybreak 05:36: « if you say to a\nresident of a certain age in the\narea, well, look, lady, you don't\nneed parking spots there because\nthe data shows that we have only\n60% of the parking used … she\ncan't park her car two blocks away\nand walk in winter with ice »\n[2026-10-09]", fillcolor="#fdf1f1", shape=box];
  s_db_route [label="Daybreak 08:19: « we vote here at\nthe borough, then a vote at the\nConseil Municipal, then it comes\nback to the borough. So, it's very\ntight. What we committed to was to\nimplement those changes before\nChristmas »\n[2026-10-09]", fillcolor="#fdf1f1", shape=box];
  s_db_entire [label="Daybreak 08:54–09:01: host « it'll\nbe the entire stretch of\nTerrebonne, whichever side you\npick »; « Yeah. We're aiming for\nit to optimize safety and also\ncomfort »\n[2026-10-09]", fillcolor="#fdf1f1", shape=box];
  s_db_kids [label="Daybreak 09:22–10:14: « I've very,\nvery, very rarely seen any kids\nuse it during winter »; « it's\nquite safe as it is »; vehicle\ntraffic reduced « by two-thirds »\n[2026-10-09]", fillcolor="#fdf1f1", shape=box];
  s_db_twothirds [label="Daybreak 09:56: « we've been able\nto reduce vehicle traffic by\ntwo-thirds »\n[2026-10-09]", fillcolor="#fdf1f1", shape=box];
  s_db_15m [label="Daybreak 10:52: « we're investing\n$1.5 million over the next two\nyears » (school zones; not in the\nOct 6 budget document)\n[2026-10-09]", fillcolor="#fdf1f1", shape=box];
  s_db_reopen [label="Daybreak 13:08, asked when the\nclosed side would reopen: by « the\ndata and the weather »\n[2026-10-09]", fillcolor="#fdf1f1", shape=box];
  s_cm_250 [label="City council 41:44: « une\nopération où on a enfoncé dans la\ngorge des résidents une perte de\n250 places de stationnement »\n[2026-10-19]", fillcolor="#fdf1f1", shape=box];
  s_cm_counters50 [label="City council 44:51: « on a annoncé\ntrès tôt dans le mandat 50\nnouveaux compteurs de nouvelle\ngénération »\n[2026-10-19]", fillcolor="#fdf1f1", shape=box];
  s_cm_doors [label="City council 7:38:24: « We went\ndoor to door, 4,000 doors »; «\nyesterday at Café Citoyens where\n40 of my residents were able to\ndiscuss »; « years of daily\ncounting data from counters across\nthe borough and the city »\n[2026-10-19]", fillcolor="#fdf1f1", shape=box];
  s_desousa_share [label="City council 7:07:49, Alan DeSousa\nto Hannah Bunty: « je pense qu'ils\nvont partager cette information\navec nous. Et puis, on vise\nd'amener ça au conseil municipal »\n[2026-10-19]", fillcolor="#fdf1f1", shape=box];
  s_desousa_review [label="City council 7:18:13, to David\nGamper: « I initiated discussions\nwith the different boroughs, of\nwhich Côte-des-Neiges-NDG was one\n»; the borough « will be sharing\nit with us … after which we will\nbe presenting a final file to\nCouncil »\n[2026-10-19]", fillcolor="#fdf1f1", shape=box];
  s_desousa_notbefore [label="City council 7:19:53: the four\nreviews' findings « in all\nlikelihood, will be as soon as\npossible, but it may not be before\nthat »; « will not necessarily …\nbe immediately exportable or\nrelevant … to Terrebonne »\n[2026-10-19]", fillcolor="#fdf1f1", shape=box];
  s_mayor_nov2025 [label="Borough council November 26, 2025,\nthe mayor: « l'audit qui a été\nfait par le SUM, qui a été demandé\npar la dernière administration »;\n« Je ne peux pas vous dire\naujourd'hui si cette piste\ncyclable va être démantelée »; «\nWe inherited this bike path »\n(machine transcript; one sentence\nquoted in request 2025-12847)\n[2025-11-26]", fillcolor="#fdf1f1", shape=box];
  s_devoir_window [label="Le Devoir, Oct 19, the mayor's\noffice by e-mail: « le maintien de\nl'aménagement cyclable tel quel\npendant la majorité de l'année,\nsoit d'avril à décembre, puis de\ngarder un seul côté durant la\nsaison hivernale »; « au moins 60\nplaces »; « il sera toujours\npossible de circuler à vélo de\npart et d'autre »\n[2026-10-19]", fillcolor="#fdf1f1", shape=box];
  s_devoir_perhour [label="Le Devoir, Oct 19: in answer to\nthe author's question the\ncouncillor acknowledged the\nper-hour reading of the « 8 »; the\ncounter « a enregistré une moyenne\nd'une quarantaine de passages par\njour »\n[2026-10-19]", fillcolor="#fdf1f1", shape=box];
  s_card_steps [label="Signed statement, Oct 6: « Several\nsteps remain before this proposal\ncan be … namely the borough\ncouncil and City Council »; « The\nsolution we are currently\ndeveloping with experts … »\n[2026-10-06]", fillcolor="#fdf1f1", shape=box];
}
subgraph cluster_event { label="events"; fontsize=11; color="#d9dcd8"; style="rounded";
  e_dec7 [label="Borough council vote\n[2026-12-07]", fillcolor="#f3eefc", shape=hexagon];
  e_zoom [label="Zoom meeting between the\ncouncillor and the APC-NDG,\nscheduled shortly before the Oct 6\nsitting (first planned as a bike\nride); cited by him at council on\nOct 6 as his consultation with the\nAPC\n[2026-10]", fillcolor="#f3eefc", shape=hexagon];
  e_oct6 [label="Borough council sitting of October\n6, 2026: the councillor's address\nand the question period\n[2026-10-06]", fillcolor="#f3eefc", shape=hexagon];
  e_daybreak [label="CBC Daybreak interview with the\ncouncillor, October 9, 2026 (the\nday the access request was\nanswered)\n[2026-10-09]", fillcolor="#f3eefc", shape=hexagon];
  e_cm_oct19 [label="City council of Montréal, October\n19, 2026: members' and public\nquestion periods (four exchanges\non Terrebonne)\n[2026-10-19]", fillcolor="#f3eefc", shape=hexagon];
  e_cm_dec [label="City council sitting of December\n14–15, 2026: the step the\ncouncillor described after the\nborough vote (\"then a vote at the\nConseil Municipal, then it comes\nback to the borough\", Daybreak\n08:19)\n[2026-12-14]", fillcolor="#f3eefc", shape=hexagon];
  e_cm_nov26_2025 [label="Borough council sitting of\nNovember 26, 2025: the mayor's\nanswer on the City's audit\n[2025-11-26]", fillcolor="#f3eefc", shape=hexagon];
  e_feb10 [label="City press release of February 10,\n2026: review of four lanes, Plan\nvélo revision, post-implementation\nfollow-up at the SUM; Terrebonne\nnamed among streets being made\nsafer with boroughs\n[2026-02-10]", fillcolor="#f3eefc", shape=hexagon];
  e_gazette [label="Montreal Gazette article of\nOctober 7, 2026 (Jesse Feith)\n[2026-10-07]", fillcolor="#f3eefc", shape=hexagon];
  e_devoir [label="Le Devoir article of October 19,\n2026 (« Une voie cyclable de la\nrue de Terrebonne sera retirée\npour l'hiver »)\n[2026-10-19]", fillcolor="#f3eefc", shape=hexagon];
  e_cm_nov16 [label="City council sitting of November\n16–17, 2026 (next public question\nperiod)\n[2026-11-16]", fillcolor="#f3eefc", shape=hexagon];
}
