  t_portal_girouard [label="City open-data detector det-00118\nat Girouard: its only Terrebonne\nchannel counts westbound, from\nOctober 23, 2025; Jan 22.6, Feb\n29.1, Mar 24.7 a day (2026)\n[2025-10-23]", fillcolor="#e8f1fb", shape=box, URL="https://donnees.montreal.ca/dataset/cyclistes", target="_blank"];
  t_csr [label="Code de la sécurité routière: art.\n341, a driver must leave at least\n1 m when passing a cyclist where\nthe limit is 50 km/h or less; art.\n487, cyclists ride as near as\npracticable to the right « en\ntenant compte de l'état de la\nchaussée et des risques\nd'emportiérage »\n[2018]", fillcolor="#e8f1fb", shape=box, URL="https://www.legisquebec.gouv.qc.ca/fr/document/lc/C-24.2", target="_blank"];
  t_opendata_method [label="City open-data page « Compteurs\ncyclistes permanents »: 2019–2026\nseries « Détecteurs installés sur\nfût » (SUM-DIGD), 2009–2025 series\n« Boucles magnétiques »; gaps and\nlimits listed\n[2026-10-21]", fillcolor="#e8f1fb", shape=box, URL="https://github.com/OpenMobilityData/Terrebonne-open-sources/blob/main/2026-city-bike-counters/README.md", target="_blank"];
